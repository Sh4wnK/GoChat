# GoChat environment template. Copy to .env and fill in real values.
#
# JWT signing secret: MUST be at least 32 bytes and shared by every
# replica. Generate one with: openssl rand -hex 32
GOCHAT_JWT_SECRET=

# Listen address (default :8080)
GOCHAT_ADDR=:8080

# PostgreSQL DSN. Unset => in-memory store (single node, no persistence).
GOCHAT_DATABASE_URL=postgres://gochat:gochat@localhost:5432/gochat?sslmode=disable

# Redis address for cluster mode. Unset => local broker (single node).
GOCHAT_REDIS_ADDR=localhost:6379

# Comma-separated allowed browser origins ("*" allows any origin).
GOCHAT_ALLOWED_ORIGINS=*
